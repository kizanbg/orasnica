#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>;
        transform = <&default_transform>;
	keys  //                      w   h x y rot rx ry
        = <&key_physical_attrs 100 100    0   60    1000     0    10>
        , <&key_physical_attrs 100 100  100   35    1000     0    10>
        , <&key_physical_attrs 100 100  200    0    1000     0    10>
        , <&key_physical_attrs 100 100  300   35    1000     0    10>
        , <&key_physical_attrs 100 100  400   70    1000     0    10>
        , <&key_physical_attrs 100 100  600  157 (-1000)   600   107>
        , <&key_physical_attrs 100 100  700  121 (-1000)   600   107>
        , <&key_physical_attrs 100 100  800   86 (-1000)   600   107>
        , <&key_physical_attrs 100 100  900  121 (-1000)   600   107>
        , <&key_physical_attrs 100 100 1000  146 (-1000)   600   107>
        , <&key_physical_attrs 100 100    0  160    1000     0    10>
        , <&key_physical_attrs 100 100  100  135    1000     0    10>
        , <&key_physical_attrs 100 100  200  100    1000     0    10>
        , <&key_physical_attrs 100 100  300  135    1000     0    10>
        , <&key_physical_attrs 100 100  400  170    1000     0    10>
        , <&key_physical_attrs 100 100  600  257 (-1000)   600   107>
        , <&key_physical_attrs 100 100  700  221 (-1000)   600   107>
        , <&key_physical_attrs 100 100  800  186 (-1000)   600   107>
        , <&key_physical_attrs 100 100  900  221 (-1000)   600   107>
        , <&key_physical_attrs 100 100 1000  246 (-1000)   600   107>
        , <&key_physical_attrs 100 100    0  260    1000     0    10>
        , <&key_physical_attrs 100 100  100  235    1000     0    10>
        , <&key_physical_attrs 100 100  200  200    1000     0    10>
        , <&key_physical_attrs 100 100  300  235    1000     0    10>
        , <&key_physical_attrs 150 100  400  270    1000     0    10>
        , <&key_physical_attrs 150 100  550  357 (-1000)   600   107>
        , <&key_physical_attrs 100 100  700  322 (-1000)   600   107>
        , <&key_physical_attrs 100 100  800  286 (-1000)   600   107>
        , <&key_physical_attrs 100 100  900  322 (-1000)   600   107>
        , <&key_physical_attrs 100 100 1000  347 (-1000)   600   107>
        , <&key_physical_attrs 100 100  200  300    1000     0    10>
        , <&key_physical_attrs 100 100  800  387 (-1000)   600   107>
	    ;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
		rows = <4>;
		columns = <10>;
        map = <
			RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
			RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
			RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
			                RC(3,2)                                 RC(3,7)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        col-gpios
            = <&gpio0     2 GPIO_ACTIVE_HIGH>
            , <&gpio1    15 GPIO_ACTIVE_HIGH>
            , <&gpio0    31 GPIO_ACTIVE_HIGH>
            , <&gpio0    29 GPIO_ACTIVE_HIGH>
            , <&gpio1    13 GPIO_ACTIVE_HIGH>
            , <&gpio1     0 GPIO_ACTIVE_HIGH>
            , <&gpio0     8 GPIO_ACTIVE_HIGH>
            , <&gpio0     6 GPIO_ACTIVE_HIGH>
            , <&gpio0    20 GPIO_ACTIVE_HIGH>
            , <&gpio0    17 GPIO_ACTIVE_HIGH>
            ;
        row-gpios
            = <&gpio1    11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0    11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1    04 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1    06 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

  encoder: encoder {
        compatible = "alps,ec11";
        label = "ENCODER";
        a-gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        resolution = <2>;
    };

    encoder2: encoder2 {
        compatible = "alps,ec11";
        label = "ENCODER2";
        a-gpios = <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        resolution = <2>;
    };

    sensors {
    	compatible = "zmk,keymap-sensors";
    	sensors = <
    		&encoder
    		&encoder2
    	>;
    };
};
